HOST=localhost
PORT=8888
MAX_BODY_SIZE=5mb

# 配置后启用私有 Source Map 上传和错误还原查询接口。
SOURCEMAP_ADMIN_TOKEN=
SOURCEMAP_DIR=./mapdata
SOURCEMAP_MAX_BODY_SIZE=30mb

# 配置后启用工作台聚合、事件、源码定位与录制只读查询。
# 普通事件与录制上传不使用该令牌；Source Map 上传使用独立管理令牌。
MONITOR_DASHBOARD_TOKEN=my_monitor_token

# 本地开发可复制为 .env；修改后重启服务。
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=root
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DATABASE=weils_monitor
CLICKHOUSE_PERFORMANCE_TABLE=frontend_performance
CLICKHOUSE_ERROR_TABLE=frontend_error
CLICKHOUSE_BEHAVIOR_TABLE=frontend_behavior
# Replay 独立分片表，默认 TTL 30 天；升级后先执行 npm run db:init。
# 运行账号需要此表 SELECT/INSERT 权限，管理查询沿用 MONITOR_DASHBOARD_TOKEN。
CLICKHOUSE_RECORD_TABLE=event_record
CLICKHOUSE_AUTO_MIGRATE=false

# 仅 npm run db:init 使用；未设置时沿用上面的账号和密码。
CLICKHOUSE_ADMIN_USERNAME=root
CLICKHOUSE_ADMIN_PASSWORD=123456
