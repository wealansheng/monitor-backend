# 监控后端环境配置：每项中文说明不改变下一行的现有配置值。
# 复制为 .env 后填写本机凭据；未设置的项目使用 configuration.ts 中的默认值。

# HTTP 监听地址；本机开发默认 localhost，需要外部访问时按部署环境设置。
HOST=0.0.0.0

# Nest HTTP 端口，默认 8888，范围 1–65535；此值不是 MySQL 端口。
PORT=8888

# 普通事件上报请求体上限，默认 5mb；Replay 独立限制为 512 KiB。
MAX_BODY_SIZE=5mb

# Source Map 独立管理令牌；留空关闭上传管理接口，勿提交真实令牌。
SOURCEMAP_ADMIN_TOKEN=

# Source Map 私有保存目录，相对路径以当前后端根目录为基准，默认 mapdata。
SOURCEMAP_DIR=./mapdata

# Source Map 单次上传请求体上限，默认 30mb。
SOURCEMAP_MAX_BODY_SIZE=30mb

# 工作台管理令牌，允许查询消费状态及触发立即入库；留空时相关接口返回 404。
MONITOR_DASHBOARD_TOKEN=

# MySQL 主机地址，默认 localhost；使用已有本机实例。
MYSQL_HOST=127.0.0.1

# MySQL TCP 端口，默认 3306，范围 1–65535。
MYSQL_PORT=3306

# 服务运行账号，默认 root；部署时按所需读写和分区维护权限配置。
MYSQL_USERNAME=monitor

# MySQL 运行账号密码；无硬编码默认值，本地实际密码仅保存在 .env。
MYSQL_PASSWORD=change-me

# 业务数据库名，默认 weils_monitor；db:init 会创建，运行服务不会自动建库。
MYSQL_DATABASE=weils_monitor

# 性能、请求和资源事件表，默认 frontend_performance，按 UTC 日分区。
MYSQL_PERFORMANCE_TABLE=frontend_performance

# 错误和稳定性事件表，默认 frontend_error，按 UTC 日分区。
MYSQL_ERROR_TABLE=frontend_error

# 行为事件表，默认 frontend_behavior，按 UTC 日分区。
MYSQL_BEHAVIOR_TABLE=frontend_behavior

# Replay 分片表，默认 event_record；保留变体唯一约束，不做时间分区。
MYSQL_RECORD_TABLE=event_record

# 启动自动执行版本化迁移开关，只接受 true/false，默认 false；始终关闭 synchronize。
MYSQL_AUTO_MIGRATE=false

# db:init 专用建库迁移账号；未设置或为空时回退 MYSQL_USERNAME。
MYSQL_ADMIN_USERNAME=root

# db:init 管理员密码；未设置时回退 MYSQL_PASSWORD，显式空值表示空密码。
MYSQL_ADMIN_PASSWORD=123456

# Redis 主机地址，默认 127.0.0.1；复用现有实例，不自动修改全局设置。
REDIS_HOST=127.0.0.1

# Redis TCP 端口，默认 6379，范围 1–65535。
REDIS_PORT=6379

# Redis 认证密码；未设置时为空，勿将本机真实密码提交到仓库。
REDIS_PASSWORD=

# Redis 逻辑数据库编号，当前使用 5，允许 0–15；测试也使用独立键前缀隔离。
REDIS_DB=5

# 监控专用键前缀，默认 monitor:<MYSQL_DATABASE>；同库消费者需保持一致以共享租约。
REDIS_KEY_PREFIX=monitor:weils_monitor

# 待处理与在途消息的总条数上限，默认 10000，允许 1–100000；超限先淘汰最旧待处理项。
MONITOR_BUFFER_MAX_ITEMS=10000

# 缓冲总序列化字节上限，默认 67108864（64 MiB），允许 1024–536870912；不等于 Redis 总内存。
MONITOR_BUFFER_MAX_BYTES=67108864

# 每批最大消息数，默认 500，允许 1–800；混合批次按四张物理表分组。
MONITOR_BATCH_SIZE=500

# 每批目标字节上限，默认 2097152（2 MiB），允许 1024–16777216；合法大元素单独处理。
MONITOR_BATCH_MAX_BYTES=2097152

# 消费控制任务刷新间隔，默认 1000 毫秒，允许 100–60000；低流量也按此周期触发。
MONITOR_FLUSH_INTERVAL_MS=1000

# 四类数据统一保留天数，默认 14，允许 1–365；保留当前 UTC 日及此前 N−1 天。
MONITOR_RETENTION_DAYS=14

# TypeORM MySQL 连接池最大连接数，默认 10，允许 1–100，由 Nest 管理关闭。
MYSQL_POOL_SIZE=10
