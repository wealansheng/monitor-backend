HOST=localhost
PORT=8888
MAX_BODY_SIZE=5mb

# 本地开发可复制为 .env；修改后重启服务。
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=root
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DATABASE=weils_monitor
CLICKHOUSE_PERFORMANCE_TABLE=frontend_performance
CLICKHOUSE_ERROR_TABLE=frontend_error
CLICKHOUSE_BEHAVIOR_TABLE=frontend_behavior
CLICKHOUSE_AUTO_MIGRATE=false

# 仅 npm run db:init 使用；未设置时沿用上面的账号和密码。
CLICKHOUSE_ADMIN_USERNAME=root
CLICKHOUSE_ADMIN_PASSWORD=123456
