{
  "name": "monitor-backend",
  "version": "1.0.0",
  "private": true,
  "description": "基于 NestJS、MySQL 和 TypeORM 的监控数据接收服务",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "db:init": "nest build && node dist/db-init.js",
    "sourcemaps:upload": "nest build && node dist/upload-sourcemaps.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:mysql": "jest --runInBand --testRegex mysql.integration.ts",
    "test:ingestion": "jest --runInBand --testRegex ingestion.redis.integration.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@nestjs/bull": "11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/typeorm": "11.0.3",
    "bull": "4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.0.0",
    "ioredis": "5.11.1",
    "mysql2": "3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
